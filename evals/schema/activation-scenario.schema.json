{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development OS activation-routing scenario",
  "type": "object",
  "required": [
    "id",
    "title",
    "kind",
    "prompt",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "activation"
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "object",
      "required": [
        "activate"
      ],
      "properties": {
        "activate": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notActivate": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
