{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development OS productive scenario",
  "type": "object",
  "required": ["id", "title", "kind", "enabled", "target", "valueIntent", "prompt", "sourcePolicy", "rubric"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "const": "productive" },
    "enabled": { "type": "boolean" },
    "target": { "type": "string", "minLength": 1 },
    "valueIntent": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "sourcePolicy": { "enum": ["read-only", "isolated-workspace"] },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
